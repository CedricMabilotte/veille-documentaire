  {
    "id": "0b22d51b",
    "type": "document",
    "title": "Ejidos mexicains : quand la terre devient marchandise",
    "URL": "https://hal.science/hal-05001941/document",
    "author": [
      {
        "given": "Kelly",
        "family": "Redouté"
      }
    ],
    "issued": {
      "date-parts": [
